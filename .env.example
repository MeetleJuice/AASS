# Fill only providers you use. Save privately as .env or .env.txt beside AASS,
# or select your existing file in the setup window. Never put it in a target project.
# Existing process bindings take precedence. Key values never belong in Git or chat.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434
AASS_WORKER_MODEL=qwen3.5:9b
# Optional explicit independent judge configuration instead of the standard key names:
# AASS_JUDGE_API_KEY=
# AASS_JUDGE_MODEL=
# AASS_JUDGE_BASE_URL=https://api.openai.com/v1
# AASS_JUDGE_PROVIDER=openai
# AASS_ALLOWED_JUDGE_HOSTS is a deliberate PROCESS setting for a trusted custom
# provider; it cannot be imported from automatically discovered credential files.

# First-run automation (default0 makes no automatic billable requests):
AASS_SETUP_ALLOW_BILLABLE_CHECK=0
# Set one intended provider when multiple keys exist:
# AASS_JUDGE_SERVICE=gemini
# Other model-provider bindings (leave unused entries blank):
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
REQUESTY_API_KEY=
HUGGINGFACE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Other OpenAI-compatible or Anthropic-compatible model endpoints:
# AASS_JUDGE_SERVICE=custom
# AASS_CUSTOM_BASE_URL=https://your-provider.example/v1
# AASS_CUSTOM_PROTOCOL=openai
# AASS_CUSTOM_API_KEY=
# AASS_CUSTOM_MODEL=vendor/model
# Full instructions: docs/AUTOMATIC-SETUP.md
