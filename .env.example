# Copy OUTSIDE the checkout; import with aass --credentials-file /private/path ...
OLLAMA_HOST=http://127.0.0.1:11434
AASS_WORKER_MODEL=qwen3.5:9b
AASS_SANDBOX_IMAGE=python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704
AASS_JUDGE_BASE_URL=https://api.openai.com/v1
# Set a model available on your own independent cloud provider/account.
AASS_JUDGE_MODEL=
AASS_JUDGE_API_KEY=

# Set anthropic only for an Anthropic endpoint; Gemini uses the openai adapter.
AASS_JUDGE_PROVIDER=openai
